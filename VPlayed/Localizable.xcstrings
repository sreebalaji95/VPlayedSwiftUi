    "We'll send a 6-digit code to verify it's you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنرسل رمزًا مكوّنًا من 6 أرقام للتحقق من هويتك."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviaremos um código de 6 dígitos para confirmar que é você."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது நீங்கள்தான் என உறுதிசெய்ய 6 இலக்கக் குறியீட்டை அனுப்புவோம்."
          }
        }
      }
    },
    "We'll text a 6-digit code to verify it's you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سنرسل رسالة نصية برمز مكوّن من 6 أرقام للتحقق من هويتك."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Enviaremos um SMS com um código de 6 dígitos para confirmar que é você."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "இது நீங்கள்தான் என உறுதிசெய்ய 6 இலக்கக் குறியீட்டை SMS மூலம் அனுப்புவோம்."
          }
        }
      }
    },
    "Welcome! Setting up your profile is coming soon." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مرحبًا! سيتوفر إعداد ملفك الشخصي قريبًا."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Boas-vindas! A configuração do seu perfil chegará em breve."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "வரவேற்கிறோம்! உங்கள் சுயவிவர அமைப்பு விரைவில் வரும்."
          }
        }
      }
    },
    "You appear to be offline. Check your connection and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو أنك غير متصل بالإنترنت. تحقّق من اتصالك وحاول مرة أخرى."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que você está offline. Verifique sua conexão e tente novamente."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் ஆஃப்லைனில் இருப்பதாகத் தெரிகிறது. இணைப்பைச் சரிபார்த்து மீண்டும் முயலவும்."
          }
        }
      }
    },
    "You have started following this channel" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد بدأت متابعة هذه القناة"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você começou a seguir este canal"
