    },
    "You appear to be offline. Check your connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أنك غير متصل بالإنترنت. تحقّق من اتصالك وحاول مرة أخرى."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que você está offline. Verifique sua conexão e tente novamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஆஃப்லைனில் இருப்பதாகத் தெரிகிறது. இணைப்பைச் சரிபார்த்து மீண்டும் முயலவும்."
          }
        }
