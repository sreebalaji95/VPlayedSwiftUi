      }
    },
    "This email isn't registered yet. Create your account on the %@ website, then sign in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا البريد الإلكتروني غير مسجّل بعد. أنشئ حسابك على موقع %@، ثم سجّل الدخول."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este e-mail ainda não está cadastrado. Crie sua conta no site do %@ e depois entre."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த மின்னஞ்சல் இன்னும் பதிவு செய்யப்படவில்லை. %@ இணையதளத்தில் கணக்கை உருவாக்கி, பின்னர் உள்நுழையவும்."
          }
        }
      }
    },
    "This isn't available in this build yet." : {
