    },
    "Titles and descriptions from %@ also switch when they're available in that language.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتغيّر أيضًا العناوين والأوصاف من %@ عندما تكون متاحة بتلك اللغة."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos e descrições do %@ também mudam quando estiverem disponíveis nesse idioma."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-இன் தலைப்புகளும் விளக்கங்களும் அந்த மொழியில் கிடைக்கும்போது அவையும் மாறும்."
          }
        }
      }
    },
