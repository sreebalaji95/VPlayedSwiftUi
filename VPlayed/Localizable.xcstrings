            "state": "translated",
            "value": "சரிபார்த்துத் தொடர்க"
          }
        }
      }
    },
    "Verify it's you": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من هويتك"
          }
