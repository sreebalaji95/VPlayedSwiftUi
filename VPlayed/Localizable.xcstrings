        }
      }
    },
    "You're signed in on the maximum number of devices. Sign out on another device, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد سجّلت الدخول على الحد الأقصى من الأجهزة. سجّل الخروج من جهاز آخر، ثم حاول مرة أخرى."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está conectado no número máximo de dispositivos. Saia em outro dispositivo e tente novamente."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அதிகபட்ச சாதனங்களில் உள்நுழைந்துள்ளீர்கள். வேறொரு சாதனத்தில் வெளியேறி, மீண்டும் முயலவும்."
          }
        }
      }
    },
    "Your %@ account is ready." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسابك على %@ جاهز."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta %@ está pronta."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் %@ கணக்கு தயார்."
          }
        }
      }
    },
    "Your account is signed in on as many devices as it allows. Sign out from one of them to continue." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حسابك مسجَّل الدخول على الحد الأقصى المسموح به من الأجهزة. سجّل الخروج من أحدها للمتابعة."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua conta está conectada no número máximo de dispositivos permitido. Saia de um deles para continuar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "உங்கள் கணக்கு அனுமதிக்கப்பட்ட அதிகபட்ச சாதனங்களில் உள்நுழைந்துள்ளது. தொடர, அவற்றில் ஒன்றிலிருந்து வெளியேறவும்."
          }
        }
      }
    },
    "Your home feed is empty" : {
