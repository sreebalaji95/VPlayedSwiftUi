        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மின்னஞ்சல் இன்னும் பதிவு செய்யப்படவில்லை. %@ இணையதளத்தில் கணக்கை உருவாக்கி, பின்னர் உள்நுழையவும்."
          }
        }
      }
    },
    "This isn't available in this build yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الميزة غير متاحة في هذا الإصدار بعد."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso ainda não está disponível nesta versão."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இந்தப் பதிப்பில் இன்னும் கிடைக்கவில்லை."
          }
        }
      }
    },
    "This screen isn't built yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
