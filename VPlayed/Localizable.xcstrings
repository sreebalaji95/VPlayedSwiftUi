            "state": "translated",
            "value": "Busca por voz"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குரல் தேடல்"
          }
        }
      }
    },
    "Watch Live": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد مباشرة"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistir ao vivo"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரலையில் பார்"
          }
        }
      }
    },
    "Watch now": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد الآن"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistir agora"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது பார்"
          }
        }
      }
    },
    "We couldn't reach %@. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الاتصال بـ %@. يُرجى المحاولة مرة أخرى."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conectar ao %@. Tente novamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ஐ அணுக முடியவில்லை. மீண்டும் முயலவும்."
          }
        }
      }
    },
    "We'll send a 6-digit code to verify it's you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنرسل رمزًا مكوّنًا من 6 أرقام للتحقق من هويتك."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos um código de 6 dígitos para confirmar que é você."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது நீங்கள்தான் என உறுதிசெய்ய 6 இலக்கக் குறியீட்டை அனுப்புவோம்."
          }
        }
      }
    },
    "You appear to be offline. Check your connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أنك غير متصل بالإنترنت. تحقّق من اتصالك وحاول مرة أخرى."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que você está offline. Verifique sua conexão e tente novamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஆஃப்லைனில் இருப்பதாகத் தெரிகிறது. இணைப்பைச் சரிபார்த்து மீண்டும் முயலவும்."
          }
        }
      }
    },
    "You have started following this channel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد بدأت متابعة هذه القناة"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você começou a seguir este canal"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சேனலைப் பின்தொடரத் தொடங்கிவிட்டீர்கள்"
          }
        }
      }
    },
    "You have unfollowed this channel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد ألغيت متابعة هذه القناة"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você deixou de seguir este canal"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சேனலைப் பின்தொடர்வதை நிறுத்திவிட்டீர்கள்"
          }
        }
      }
    },
    "You're all set": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء جاهز"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo pronto"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எல்லாம் தயார்"
          }
        }
      }
    },
    "You're signed in on the maximum number of devices. Sign out on another device, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد سجّلت الدخول على الحد الأقصى من الأجهزة. سجّل الخروج من جهاز آخر، ثم حاول مرة أخرى."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está conectado no número máximo de dispositivos. Saia em outro dispositivo e tente novamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிகபட்ச சாதனங்களில் உள்நுழைந்துள்ளீர்கள். வேறொரு சாதனத்தில் வெளியேறி, மீண்டும் முயலவும்."
          }
        }
      }
    },
    "Your %@ account is ready.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسابك على %@ جاهز."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta %@ está pronta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் %@ கணக்கு தயார்."
          }
        }
      }
    },
    "Your home feed is empty": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحتك الرئيسية فارغة"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Início está vazio"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் முகப்பு காலியாக உள்ளது"
          }
        }
      }
    },
    "Your session has expired. Please sign in again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلستك. يُرجى تسجيل الدخول مرة أخرى."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão expirou. Entre novamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அமர்வு காலாவதியானது. மீண்டும் உள்நுழையவும்."
          }
        }
      }
    },
    "or continue with email": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أو تابع باستخدام البريد الإلكتروني"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ou continue com e-mail"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அல்லது மின்னஞ்சல் மூலம் தொடர்க"
          }
        }
      }
    },
    "· Save up to %lld%%": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "· وفّر حتى %lld%%"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "· Economize até %lld%%"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "· %lld%% வரை சேமியுங்கள்"
          }
        }
      }
    }
  },
  "version": "1.0"
}
