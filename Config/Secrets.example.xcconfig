// Template for Config/Secrets.xcconfig (git-ignored). Copy it, fill in the value, never commit it:
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
// Brand.xcconfig includes Secrets.xcconfig when it exists.

// Request-payload encryption passphrase for the auth endpoints (the backend's SALT_KEY, the same
// value as AndroidJP's secrets.properties `vplayed.saltKey`). Without it, email sign-in reports an
// error and sends nothing.
VPLAYED_TRANSPORT_KEY =

// Google and Apple sign-in, phone sign-in (Firebase Auth). Leave empty to hide Google sign-in and
// fall back to email sign-in when the backend asks for phone verification. Each environment has its
// own bundle ID, so register each one with Firebase / Google and set per-configuration values, e.g.
//   VPLAYED_FIREBASE_APP_ID[config=DebugDev] = 1:000000000000:ios:0000000000000000000000
// Never copy them from the UIKit app: its Firebase project is registered for other bundle IDs.

// OAuth client ID of the iOS app (Google Cloud console) and its reversed form, the URL scheme
// Google sends the user back to (com.googleusercontent.apps.<id>).
VPLAYED_GOOGLE_CLIENT_ID =
VPLAYED_GOOGLE_URL_SCHEME =

// From the Firebase iOS app's GoogleService-Info.plist: API_KEY, GOOGLE_APP_ID, GCM_SENDER_ID, PROJECT_ID.
VPLAYED_FIREBASE_API_KEY =
VPLAYED_FIREBASE_APP_ID =
VPLAYED_FIREBASE_SENDER_ID =
VPLAYED_FIREBASE_PROJECT_ID =
// The encoded app ID scheme (app-1-<sender>-ios-<hash>) phone sign-in returns to after its reCAPTCHA check.
VPLAYED_FIREBASE_URL_SCHEME =
